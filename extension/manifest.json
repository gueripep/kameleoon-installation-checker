{
  "manifest_version": 3,
  "name": "Kameleoon Installation Checker",
  "version": "1.0.0",
  "description": "Check and validate Kameleoon snippet installation on websites.",
  "permissions": [
    "activeTab",
    "storage",
    "browsingData",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Check Kameleoon Installation"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["inject.js"],
      "matches": ["<all_urls>"]
    }
  ]
}
